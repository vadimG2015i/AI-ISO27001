# Application Configuration
APP_NAME="AI ISO 27001 Compliance Assistant"
DEBUG=False
LOG_LEVEL=INFO

# Storage Paths
DATABASE_URL="sqlite:///data/app.db"
UPLOAD_DIR="data/uploads"
STANDARDS_FILE="data/standards/iso27001_2022.json"

# AI / LLM Configuration
# Supported providers: mock (offline, zero-cost default), openai, gemini, anthropic, ollama, azure
LLM_PROVIDER="mock"
LLM_MODEL="mock-audit-v1"

# Provider Credentials (Optional - leave blank for offline mock operation)
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
OLLAMA_BASE_URL="http://localhost:11434"
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-api-key-here"
